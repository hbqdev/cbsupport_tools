{
 "version": 1,
 "categories": [
  {
   "id": "failover",
   "title": "Failover",
   "group": "Cluster",
   "desc": "Failover and auto-failover decisions, and why a node was considered down.",
   "rx": "fail ?over|auto-failover|considered down|node .{0,40}(down|unreachable)|failed over",
   "files": [
    "ns_server.info.log",
    "ns_server.debug.log",
    "ns_server.error.log",
    "diag.log",
    "ns_server.babysitter.log",
    "memcached.log",
    "ns_server.http_access.log"
   ],
   "keywords": [
    "failover",
    "fail over",
    "failed over",
    "auto-failover"
   ],
   "components": [
    "cluster management",
    "cluster manager",
    "failover"
   ],
   "counts": false,
   "fixed": false,
   "pcre2": false,
   "extra": "systemd_journal.gz (OOM kills, reboots)",
   "enabled": true,
   "case_types": [
    "failover",
    "node failover"
   ]
  },
  {
   "id": "rebalance_failed",
   "title": "Rebalance failed or stuck",
   "group": "Cluster",
   "desc": "Why a rebalance failed, stopped or never finished: moves, backfill waits, janitor activity, who stopped it.",
   "rx": "rebalance.{0,80}(fail|stop|exit|abort|stuck|error)|Still waiting for backfill|Skipping janitor|bad_replicas|stopRebalance|rebalance_failed|janitor_agent.{0,40}(fail|error)",
   "files": [
    "ns_server.info.log",
    "ns_server.debug.log",
    "ns_server.error.log",
    "diag.log",
    "memcached.log",
    "ns_server.indexer.log",
    "ns_server.http_access.log"
   ],
   "keywords": [
    "rebalance",
    "stuck",
    "stall",
    "wedge"
   ],
   "components": [
    "cluster management",
    "cluster manager",
    "rebalance"
   ],
   "counts": false,
   "fixed": false,
   "pcre2": false,
   "extra": "rebalance_report_*.json (one per rebalance, with the failure reason)",
   "enabled": true,
   "case_types": [
    "rebalance"
   ]
  },
